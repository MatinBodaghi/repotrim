# ==============================================================================
# RepoTrim — Git Ignore Configuration
# Modeled after top-tier Rust open-source projects (ripgrep, uv, tokio)
# ==============================================================================

# --- Rust & Cargo Build Artifacts ---
/target/
**/*.rs.bk
*.pdb

# --- Profiling, Benchmarks & Performance Traces ---
perf.data
perf.data.old
flamegraph.svg
*.profraw
*.profdata
*.callgrind

# --- Code Coverage & Test Reports ---
coverage/
cobertura.xml
tarpaulin-report.html
lcov.info

# --- Environment, Secrets & Local Credentials ---
.env
.env.*
!.env.example

# --- Logs, Dumps & Crash Reports ---
*.log
*.dmp
*.crash
*.stackdump

# --- Operating System Artifacts ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# --- IDEs & Code Editors ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, RustRover, CLion)
.idea/
*.iml
*.iws

# Visual Studio
.vs/
*.user
*.suo

# Vim / Emacs
*.swp
*.swo
[#]*[#]
.#*

# --- Temporary, Scratch & Backup Files ---
scratch/
tmp/
*.tmp
*.bak
*.orig
*.patch

# --- RepoTrim Runtime Cache Directory ---
.repotrim/
crates/engine/.repotrim/
crates/cli/.repotrim/
crates/mcp-server/.repotrim/

# --- Antigravity & Local Agent Harness Configs ---
mcp_config.json
.agents/mcp_config.json
